{
  "name": "star-icons",
  "version": "1.0.0",
  "description": "Star Icons — the icon collection manager for Obsidian. Bundle Lucide, Material Symbols and custom star icons; organize them into collections and tags; apply them to files, folders and tabs with an intuitive rules engine and live preview.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build:icons": "node scripts/build-icon-data.mjs",
    "test": "vitest run --pool=threads",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "icons",
    "icon-manager",
    "icon-collections"
  ],
  "author": "Star Icons",
  "license": "MIT",
  "devDependencies": {
    "@ant-design/icons-svg": "^4.5.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@iconscout/unicons": "^4.2.0",
    "@material-symbols/svg-400": "^0.46.0",
    "@phosphor-icons/core": "^2.1.1",
    "@primer/octicons": "^19.33.0",
    "@svgmoji/twemoji": "^3.2.0",
    "@tabler/icons": "^3.46.0",
    "@types/node": "^26.2.0",
    "bootstrap-icons": "^1.13.1",
    "boxicons": "^2.1.4",
    "css.gg": "^2.1.4",
    "emoji-datasource-google": "^16.0.0",
    "esbuild": "^0.28.2",
    "eva-icons": "^1.1.3",
    "fluentui-emoji": "^1.3.0",
    "heroicons": "^2.2.0",
    "ionicons": "^8.1.0",
    "line-awesome": "^1.3.0",
    "lucide-static": "^1.31.0",
    "obsidian": "^1.13.1",
    "openmoji": "^17.0.0",
    "remixicon": "^4.9.1",
    "simple-icons": "^16.28.0",
    "tslib": "^2.8.1",
    "twemoji": "^14.0.2",
    "twemoji-svg": "^17.0.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
